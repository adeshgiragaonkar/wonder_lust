<%- layout("./layout/biolerplate.ejs") %>
<body>
     
    <div class="row">   
    <div class="col-8 offset-2">
        <br><br>
        <h3>Create New Listing</h3>
    <form method="post" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">
        <div class="mb-3">    
            <label for="title" class="form-label">Title</label>
            <input type="text" placeholder="add a catchy title" name="listing[title]" id="title" class="form-control" required>
            <div class="valid-feedback">title looks good!</div>
            <div class="invalid-feedback">please enter title!</div>
        </div>  
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" id="description" class="form-control" placeholder="Leave Description here.." required></textarea>
            <div class="invalid-feedback">please leave some description!</div>
        </div>
        
        <div class="mb-3">
            <label for="image" class="form-label">Image URL/link</label>
            <input type="file" placeholder="add Image URL/Link" name="listing[image]" id="image" class="form-control" required>
        </div>
   
        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="price" class="form-label">Price</label>
                <input type="number" placeholder="e.g 1200" name="listing[price]" id="price" class="form-control" required>
                <div class="invalid-feedback">please enter valid price!</div>
            </div>
       
            <div class="mb-3 col-md-8">
                <label for="location" class="form-label">Location</label>
                <input type="text" placeholder="e.g benguluru" name="listing[location]" id="country" class="form-control" required>
                <div class="invalid-feedback">please please enter valid location!</div>
            </div>
        </div>

        <div class="mb-3">
            <label for="country" class="form-label">Country</label>
            <input type="text" placeholder="e.g India" name="listing[country]" id="country" class="form-control" required>
            <div class="invalid-feedback">please enter valid country!</div>
        </div>
        
        <br><br>
        <button class="btn btn-dark cust-btn">Submit</button>
        <br><br>
    </form>
    </div>
    </div>
</body>
</html>